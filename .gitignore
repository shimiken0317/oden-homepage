# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/package-lock.json
/.npm-cache
/.pnpm-store
/.openai/.openai
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
*.pem
*.log
/logs/
/.idea/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
/.turbo/

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Private originals, generation requests, and unapproved illustrations.
# Nothing under this directory may be committed or deployed.
/.private/

# `build/` is intentionally tracked: it contains source for the Sites Vite
# integration, not generated build output.
